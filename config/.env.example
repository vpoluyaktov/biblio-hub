# BiblioHub Environment Configuration
# Copy this file to .env and adjust values as needed

# =============================================================================
# Books Library Path (for OPDS Server)
# =============================================================================
BOOKS_LIBRARY_PATH=/data/books

# =============================================================================
# BiblioHub Configuration
# =============================================================================
# Hostname/IP where BiblioHub is accessible (for Keycloak redirects)
BIBLIO_HUB_HOSTNAME=localhost
# Port where BiblioHub is accessible
BIBLIO_HUB_PORT=9900

# =============================================================================
# OIDC Client Secrets
# =============================================================================
# OPDS Server OIDC client secret (get from OIDC provider admin console)
OPDS_OIDC_CLIENT_SECRET=your-opds-client-secret-here

# =============================================================================
# TTS Server Silero Configuration
# =============================================================================
# Comma-separated list of Silero models to load
SILERO_MODELS=v3_en,v5_ru,v5_1_ru

# Number of Silero TTS server replicas for parallel processing
TTS_SILERO_REPLICAS=3

# =============================================================================
# TTS Server OpenVoice Configuration
# =============================================================================
# Comma-separated list of languages to load (EN, ES, FR, ZH, JP, KR)
OPENVOICE_LANGUAGES=EN,ES

# Number of OpenVoice TTS server replicas
TTS_OPENVOICE_REPLICAS=1

# =============================================================================
# Timezone
# =============================================================================
TZ=UTC

# =============================================================================
# Keycloak Authentication (Optional)
# =============================================================================
# Enable/disable authentication at gateway level
AUTH_ENABLED=false

# Keycloak admin credentials (change in production!)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak database credentials
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

# BiblioHub hostname/IP and port (for Keycloak redirects and service URLs)
BIBLIO_HUB_HOSTNAME=localhost
BIBLIO_HUB_PORT=9900
