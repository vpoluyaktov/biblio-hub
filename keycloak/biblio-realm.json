{
  "realm": "biblio",
  "displayName": "BiblioHub",
  "displayNameHtml": "<b>BiblioHub</b> Authentication",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "defaultRole": {
    "name": "user",
    "description": "Regular BiblioHub user"
  },
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Regular BiblioHub user - access to all services",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "admin",
        "description": "BiblioHub administrator - full access including user management",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "opds_user",
        "description": "OPDS feed access - for e-readers and service-to-service Basic Auth",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "groups": [
    {
      "name": "opds_users",
      "realmRoles": ["opds_user"]
    }
  ],
  "users": [
    {
      "username": "testadmin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Admin",
      "email": "admin@bibliohub.local",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["user", "admin", "opds_user"],
      "groups": ["opds_users"]
    },
    {
      "username": "testuser",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "email": "user@bibliohub.local",
      "credentials": [
        {
          "type": "password",
          "value": "user123",
          "temporary": false
        }
      ],
      "realmRoles": ["user", "opds_user"],
      "groups": ["opds_users"]
    }
  ],
  "clients": [
    {
      "clientId": "nginx-gateway",
      "name": "Nginx Gateway",
      "description": "Nginx auth_request integration",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:9900",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:9900/*"],
      "webOrigins": ["http://localhost:9900"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "abb-tts",
      "name": "Audiobook Builder TTS",
      "description": "Audiobook Builder frontend",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:9900/abb-tts",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:9900/abb-tts/*"],
      "webOrigins": ["http://localhost:9900"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "opds-server",
      "name": "OPDS Server",
      "description": "OPDS Server frontend",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:9900/catalog",
      "baseUrl": "/",
      "redirectUris": [
        "http://10.100.0.4:9900/catalog/api/auth/oidc/callback",
        "http://localhost:9900/catalog/api/auth/oidc/callback"
      ],
      "webOrigins": [
        "http://10.100.0.4:9900",
        "http://localhost:9900"
      ],
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "tts-silero",
      "name": "TTS Server Silero",
      "description": "Internal TTS service",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "tts-openvoice",
      "name": "TTS Server OpenVoice",
      "description": "Internal TTS service",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    }
  ],
  "accessTokenLifespan": 1800,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespan": 5184000,
  "clientSessionIdleTimeout": 1800,
  "clientSessionMaxLifespan": 28800,
  "accessCodeLifespan": 300,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 300,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,
  "oauth2DeviceCodeLifespan": 600,
  "oauth2DevicePollingInterval": 5
}
