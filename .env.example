# =============================================================================
# BiblioHub Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed

# =============================================================================
# General Settings
# =============================================================================
# Timezone for all services
TZ=UTC

# =============================================================================
# BiblioHub Gateway
# =============================================================================
# Hostname/IP where BiblioHub is accessible (used for redirects and callbacks)
BIBLIO_HUB_HOSTNAME=localhost

# Port where BiblioHub is accessible
BIBLIO_HUB_PORT=9900

# =============================================================================
# Biblio Catalog (E-book Library)
# =============================================================================
# Path to e-book library directory
EBOOKS_PATH=/data/EBooks

# Legacy alias (deprecated, use EBOOKS_PATH)
BOOKS_LIBRARY_PATH=/data/books

# =============================================================================
# Audiobook Builder TTS
# =============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR)
ABB_TTS_LOG_LEVEL=INFO

# =============================================================================
# TTS Server Silero
# =============================================================================
# Comma-separated list of Silero models to load (v3_en, v5_ru, v5_1_ru, etc.)
SILERO_MODELS=v3_en,v5_ru,v5_1_ru

# Number of Silero TTS server replicas for parallel processing
TTS_SILERO_REPLICAS=5

# =============================================================================
# TTS Server OpenVoice (MeloTTS)
# =============================================================================
# Comma-separated list of languages to load (EN, ES, FR, ZH, JP, KR)
OPENVOICE_LANGUAGES=EN,ES

# Number of OpenVoice TTS server replicas
TTS_OPENVOICE_REPLICAS=5

# =============================================================================
# Stress Server Silero (Russian Text Stress Marking)
# =============================================================================
# Number of Stress server replicas for parallel processing
STRESS_SILERO_REPLICAS=8

# =============================================================================
# Biblio Auth - Authentication & User Management
# =============================================================================
# JWT secret key for token signing (REQUIRED - generate with: openssl rand -base64 32)
BIBLIO_AUTH_SECRET_KEY=

# Token expiry in seconds (default: 86400 = 24 hours)
BIBLIO_AUTH_TOKEN_EXPIRY=86400

# Default admin user password (change in production!)
BIBLIO_AUTH_ADMIN_PASSWORD=admin

# Default regular user password (change in production!)
BIBLIO_AUTH_USER_PASSWORD=user

# =============================================================================
# Biblio Auth - Security Settings
# =============================================================================
# Set Secure flag on cookies (requires HTTPS; set to false for HTTP development)
BIBLIO_AUTH_SECURE_COOKIES=true

# CORS allowed origins (comma-separated, empty = same-origin only)
# Example: http://localhost:9900,https://yourdomain.com
BIBLIO_AUTH_ALLOWED_ORIGINS=

# Trusted hosts for returnUrl validation (comma-separated)
# Example: localhost:9900,yourdomain.com
BIBLIO_AUTH_TRUSTED_HOSTS=

# =============================================================================
# Biblio Auth - Rate Limiting & Lockout
# =============================================================================
# Rate limiting: max login requests per window (default: 5, increase for OPDS clients)
BIBLIO_AUTH_RATE_LIMIT_REQUESTS=5000

# Rate limiting: window in seconds (default: 60)
BIBLIO_AUTH_RATE_LIMIT_WINDOW=60

# Account lockout: failed attempts before lockout (default: 5)
BIBLIO_AUTH_LOCKOUT_THRESHOLD=5

# Account lockout: duration in seconds (default: 900 = 15 minutes)
BIBLIO_AUTH_LOCKOUT_DURATION=900
